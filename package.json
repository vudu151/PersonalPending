{
  "name": "so-chi-tieu",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute so-chi-tieu --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute so-chi-tieu --local --file=schema.sql",
    "backup": "wrangler d1 export so-chi-tieu --remote --output=backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
